@startuml

' ========== إعدادات أساسية ==========
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam roundcorner 10
skinparam backgroundColor #F9F9F9
skinparam arrowColor #333333
skinparam arrowFontSize 13
skinparam linetype ortho

title "خطة اختبار نظام الكتاب الجديد (Book Ecosystem Testing Plan)"

' ========== الألوان ==========
!define UNIT_COLOR      #E1F5FE
!define FEATURE_COLOR   #E8EAF6
!define SERVICE_COLOR   #F3E5F5
!define REFACTOR_COLOR  #FFEBEE

' ======================================================================================
' 1. Unit Tests (اختبارات الوحدات)
' ======================================================================================
package "Unit Tests (New Models)" <<UNIT_COLOR>> {
    
    class "BookUnitRefactorTest" {
        + test_book_has_versions_relation()
        + test_book_authors_relation()
        + test_book_bookers_polymorphic_relation()
    }

    class "VersionTest" {
        + test_version_belongs_to_book()
        + test_version_belongs_to_publisher()
        + test_isbn_format_validation()
        + test_file_path_integrity()
    }

    class "AuthorTest" {
        + test_author_has_books_relation()
        + test_author_slug_generation()
    }

    class "BookerTest" {
        + test_booker_morph_relation()
        + test_role_attribute_in_pivot()
    }
}

' ======================================================================================
' 2. Service Logic Tests (اختبارات المنطق)
' ======================================================================================
package "Logic Tests (Services)" <<SERVICE_COLOR>> {
    
    class "BookManagerServiceTest" {
        + test_create_book_creates_version_automatically()
        + test_create_book_attaches_authors()
        + test_transaction_rolls_back_on_failure()
    }

    class "BookQueryServiceTest" {
        + test_filter_by_author()
        + test_filter_by_publisher()
        + test_filter_by_topic()
    }
}

' ======================================================================================
' 3. Feature Tests (اختبارات الميزات الكاملة)
' ======================================================================================
package "Feature Tests (Integration)" <<FEATURE_COLOR>> {
    
    class "BookWorkflowTest" {
        + test_user_can_create_book_with_full_details()
        + test_user_can_add_new_version_to_existing_book()
        + test_book_page_shows_all_versions()
    }
    
    class "MediaWorkflowTest" {
        + test_audio_links_to_author()
        + test_video_links_to_booker()
    }
}

' ======================================================================================
' 4. Refactoring Tests (اختبارات الكود القديم)
' ======================================================================================
package "Refactoring Safety Tests" <<REFACTOR_COLOR>> {
    
    class "LegacyStorageSyncTest" {
        + test_storage_sync_creates_versions_instead_of_modifying_book()
        + test_old_book_routes_redirect_correctly()
    }
}

' ========== العلاقات ==========

' الوحدة أولاً
BookUnitRefactorTest --> BookManagerServiceTest : Validates Model basics

' ثم الخدمة
BookManagerServiceTest --> BookWorkflowTest : Validates Business Logic

' أخيراً الميزات
BookWorkflowTest ..> LegacyStorageSyncTest : Ensure backward compatibility

@enduml
